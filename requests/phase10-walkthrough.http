### C1) Empty state route (ORD -> FCO)
# @name searchEmpty
# Expected: 200 OK
# Verify: flights is an empty array []
POST {{baseUrl}}/api/flights/search
Content-Type: application/json

{
  "origin": "ORD",
  "destination": "FCO",
  "departureDate": "{{futureDate}}",
  "passengers": 1,
  "cabinClass": "Economy"
}

### D3) Unknown/expired searchId simulation
# Expected: 409 Conflict
# Verify: ProblemDetails body with offer expired semantics
POST {{baseUrl}}/api/bookings
Content-Type: application/json

{
  "searchId": "00000000-0000-0000-0000-000000000000",
  "flightId": "{{searchIntl.response.body.$.flights[0].id}}",
  "passengers": [
    {
      "fullName": "Jane Doe",
      "email": "jane@example.com",
      "documentNumber": "X1234567"
    }
  ]
}

### Optional hardening checks (from prior phase)

### flightId not found in search context
# Expected: 404 Not Found
POST {{baseUrl}}/api/bookings
Content-Type: application/json

{
  "searchId": "{{searchIntl.response.body.$.searchId}}",
  "flightId": "globalair-NOPE-20261201-Economy",
  "passengers": [
    {
      "fullName": "Jane Doe",
      "email": "jane@example.com",
      "documentNumber": "X1234567"
    }
  ]
}

### Passenger count mismatch
# @name searchTwoPax
# Expected: 200 OK
POST {{baseUrl}}/api/flights/search
Content-Type: application/json

{
  "origin": "JFK",
  "destination": "LHR",
  "departureDate": "{{futureDate}}",
  "passengers": 2,
  "cabinClass": "Economy"
}

### Booking with fewer passengers than searched
# Expected: 400 Bad Request (passenger count mismatch)
POST {{baseUrl}}/api/bookings
Content-Type: application/json

{
  "searchId": "{{searchTwoPax.response.body.$.searchId}}",
  "flightId": "{{searchTwoPax.response.body.$.flights[0].id}}",
  "passengers": [
    {
      "fullName": "Jane Doe",
      "email": "jane@example.com",
      "documentNumber": "X1234567"
    }
  ]
}

