<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SkyRoute.Domain\SkyRoute.Domain.csproj" />
    <ProjectReference Include="..\SkyRoute.Application\SkyRoute.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Allows SkyRoute.Tests to unit-test internal types (e.g. RouteFareTable) directly,
         without widening Infrastructure's public surface beyond what the execution plan
         describes. Standard .NET pattern, not a new architectural layer. -->
    <InternalsVisibleTo Include="SkyRoute.Tests" />
  </ItemGroup>

</Project>
